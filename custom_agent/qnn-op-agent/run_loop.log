import numpy as np
import os
np.random.seed(42)
# rsqrt needs x > 0; use abs(normal) + 0.1 to keep away from zero
x = np.abs(np.random.standard_normal((1, 1, 128, 1))).astype(np.float16) + np.float16(0.1)
print('shape:', x.shape, 'dtype:', x.dtype)
print('min:', float(x.min()), 'max:', float(x.max()), 'mean:', float(x.mean()))
out_dir = '/home/yinrun/workspace/opencode/custom_agent/qnn-op-agent/ops/rsqrt/inputs'
os.makedirs(out_dir, exist_ok=True)
x.tofile(os.path.join(out_dir, 'in.raw'))
print('Saved:', os.path.join(out_dir, 'in.raw'), os.path.getsize(os.path.join(out_dir, 'in.raw')), 'bytes')

# Numpy reference: fp16 -> fp32 promote, fp32 rsqrt, single fp16 round
xf = x.astype(np.float32)
y = (1.0 / np.sqrt(xf)).astype(np.float16)
print('y range:', float(y.min()), float(y.max()))
ref_dir = '/home/yinrun/workspace/opencode/custom_agent/qnn-op-agent/ops/rsqrt/outputs/ref'
os.makedirs(ref_dir, exist_ok=True)
y.tofile(os.path.join(ref_dir, 'out_ref.raw'))
print('Saved:', os.path.join(ref_dir, 'out_ref.raw'), os.path.getsize(os.path.join(ref_dir, 'out_ref.raw')), 'bytes')
"

