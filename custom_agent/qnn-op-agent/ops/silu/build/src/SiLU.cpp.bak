#include <cmath>
#include "HTP/core/constraints.h"
#include "HTP/core/op_package_feature_support.h"
#include "HTP/core/op_register_ext.h"
#include "HTP/core/optimize.h"
#include "HTP/core/simple_reg.h"

/*
 * SiLU (Sigmoid Linear Unit) HTP op package
 *
 *     y = x * sigmoid(x) = x / (1 + exp(-x))
 *
 * Element-wise, no reduction, no parameters.
 * Computed in fp32 (numerically stable two-branch form) and cast back to
 * the tensor's element type.
 */

BEGIN_PKG_OP_DEFINITION(PKG_SiLU);

// Forward declaration
template <typename T_Ttype>
int siluImpl(T_Ttype &out, const T_Ttype &in);

DEF_TENSOR_PROPERTIES(Op("SiLU", "in0"), MainMemory("*", "in0"))

DEF_PACKAGE_OP_AND_COST_AND_FLAGS((siluImpl<PlainFloatTensor>),
                                  "SiLU",
                                  SNAIL,
                                  Flags::RESOURCE_HVX)

/* Execute function */
template <typename T_Ttype>
int siluImpl(T_Ttype &out, const T_Ttype &in) {
    debuglog("silu execute... dims=(%zdx%zdx%zdx%zd)",
             in.dim(0), in.dim(1), in.dim(2), in.dim(3));
    out.set_dims(in);

    const size_t d0 = in.dim(0);
    const size_t d1 = in.dim(1);
    const size_t d2 = in.dim(2);
    const size_t d3 = in.dim(3);

    for (size_t i0 = 0; i0 < d0; i0++) {
        for (size_t i1 = 0; i1 < d1; i1++) {
            for (size_t i2 = 0; i2 < d2; i2++) {
                for (size_t i3 = 0; i3 < d3; i3++) {
                    float x = (float)in(i0, i1, i2, i3);
                    // numerically-stable SiLU: avoid exp() of large positives.
                    // x >= 0 :  y = x / (1 + exp(-x))    (exp(-x) in [0,1])
                    // x <  0 :  y = x * exp(x) / (1 + exp(x))  (exp(x) in [0,1])
                    float y;
                    if (x >= 0.0f) {
                        y = x / (1.0f + expf(-x));
                    } else {
                        float ex = expf(x);
                        y = x * ex / (1.0f + ex);
                    }
                    out(i0, i1, i2, i3) = y;
                }
            }
        }
    }
    return GraphStatus::Success;
}

END_PKG_OP_DEFINITION(PKG_SiLU);
